{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "m6c-c-reserved-service-preregistration-v1",
  "title": "M6C-C Reserved-Service Replay Preregistration",
  "type": "object",
  "required": [
    "schema_version",
    "stage",
    "created_at_utc",
    "final_enum",
    "authority_artifacts",
    "source_evidence_index",
    "source_inventory",
    "run_split",
    "split_validator",
    "parameter_sources",
    "quantile_definition",
    "rounding_quantum_ns",
    "calibration_statistics",
    "derived_age_values_ns",
    "candidate_allowlist",
    "metric_definitions",
    "material_worse_definition",
    "fairness_budgets",
    "urgency_budgets",
    "calibration_gate",
    "holdout_gate",
    "robustness_boundary",
    "missing_invalid_rules",
    "output_artifact_schema",
    "execution_stage_boundaries",
    "expected_m6c_d_command",
    "random_seed",
    "counterfactual_type",
    "physical_system_reexecuted",
    "performance_claim",
    "formal_parameters_selected",
    "s1_evidence_parameter_comparison_executed",
    "forbidden_actions",
    "next_stage_requires_human_approval"
  ],
  "properties": {
    "schema_version": {"const": "m6c-c-reserved-service-preregistration-v1"},
    "stage": {"const": "M6C-C Reserved-Service Replay Preregistration"},
    "final_enum": {
      "enum": [
        "PREREGISTRATION_READY_FOR_S1_REPLAY",
        "PARAMETER_SOURCE_INVALID",
        "PRIMARY_RUN_SPLIT_INVALID",
        "METRIC_OR_GATE_UNRESOLVED",
        "EVIDENCE_INPUT_CHANGED",
        "M6C_ROUTE_STOP_RECOMMENDED"
      ]
    },
    "rounding_quantum_ns": {"const": 1000000},
    "random_seed": {"const": "none"},
    "counterfactual_type": {
      "const": "fixed_arrival_fixed_service_slot_policy_replay"
    },
    "physical_system_reexecuted": {"const": false},
    "performance_claim": {"const": false},
    "formal_parameters_selected": {"type": "boolean"},
    "s1_evidence_parameter_comparison_executed": {"const": false},
    "next_stage_requires_human_approval": {"const": true},
    "authority_artifacts": {"type": "array", "minItems": 5},
    "source_evidence_index": {"type": "object"},
    "source_inventory": {"type": "array", "minItems": 1},
    "run_split": {
      "type": "object",
      "required": ["calibration", "holdout", "robustness"],
      "properties": {
        "calibration": {"type": "array", "minItems": 4, "maxItems": 4},
        "holdout": {"type": "array", "minItems": 6, "maxItems": 6},
        "robustness": {"type": "array", "minItems": 20, "maxItems": 20}
      }
    },
    "candidate_allowlist": {"type": "array", "minItems": 5, "maxItems": 5},
    "derived_age_values_ns": {
      "type": "object",
      "required": ["AGE_MODERATE", "AGE_SPARSE"],
      "properties": {
        "AGE_MODERATE": {"type": "integer", "minimum": 1},
        "AGE_SPARSE": {"type": "integer", "minimum": 1}
      }
    }
  },
  "additionalProperties": true
}
