{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "m6c-b2-evidence-finalization-report-v1",
  "title": "M6C-B.2 Evidence Finalization and Hash Repair Report",
  "type": "object",
  "required": [
    "schema_version",
    "final_enum",
    "supersedes",
    "supersession_reason",
    "superseded_output_classification",
    "repair",
    "source_inventory",
    "runtime_source_audit",
    "tests",
    "reconstructability",
    "s0_replay",
    "artifact_finalization",
    "superseded_report_s0_comparison",
    "post_write_independent_validator",
    "risk_status_update",
    "counterfactual_type",
    "physical_system_reexecuted",
    "performance_claim",
    "formal_parameters_selected",
    "s1_evidence_parameter_comparison_executed"
  ],
  "properties": {
    "schema_version": {"const": "m6c-b2-evidence-finalization-report-v1"},
    "final_enum": {
      "enum": [
        "M6C_B_EVIDENCE_REPAIRED_AND_CONFIRMED",
        "HASH_FINALIZATION_FIX_FAILED",
        "DECISION_STREAM_CONTENT_NOT_DETERMINISTIC",
        "S0_RESULT_CHANGED_AFTER_REPAIR",
        "ADDITIONAL_EVIDENCE_MISMATCH_FOUND",
        "M6C_B_REQUIRES_REIMPLEMENTATION"
      ]
    },
    "supersedes": {"const": "m6c_b_offline_20260805_a3_s0_v3"},
    "supersession_reason": {
      "const": "decision stream SHA calculated before buffered stream finalization"
    },
    "superseded_output_classification": {
      "const": "technically informative but non-canonical"
    },
    "counterfactual_type": {
      "const": "fixed_arrival_fixed_service_slot_policy_replay"
    },
    "physical_system_reexecuted": {"const": false},
    "performance_claim": {"const": false},
    "formal_parameters_selected": {"const": false},
    "s1_evidence_parameter_comparison_executed": {"const": false},
    "repair": {"type": "object"},
    "source_inventory": {"type": "object"},
    "runtime_source_audit": {"type": "object"},
    "tests": {"type": "object"},
    "reconstructability": {"type": "object"},
    "s0_replay": {"type": "object"},
    "artifact_finalization": {
      "type": "object",
      "required": [
        "decision_stream_sha_report_matches_actual",
        "decision_stream_line_count_matches",
        "decision_stream_jsonl_parseable"
      ]
    },
    "superseded_report_s0_comparison": {"type": "object"},
    "post_write_independent_validator": {"type": "object"},
    "risk_status_update": {"type": "object"}
  },
  "additionalProperties": true
}
